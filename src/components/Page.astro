  }
  @media (min-width: 64rem) {
    .intro > .motion-toggle:not([hidden]) {
      position: absolute;
      right: var(--gutter);
      bottom: calc(var(--pad-end) + 0.35rem);
      margin: 0;
    }
  }
  /* Phones: the three numbers stack, and the scene fills the screen (the words are few, so
     without this it would shrink to their height and hide most of the painting). */
  @media (max-width: 46rem) {
    .figures {
      grid-template-columns: minmax(0, 1fr);
    }
    /* With very large text the tag drops under its number instead of running off the screen. */
    .figures a {
      flex-wrap: wrap;
      row-gap: 0;
    }
    .hero {
      --min-h: min(100svh, 52rem);
    }
  }
  /* One sentence per line; a sentence too long for the screen splits evenly. */
  .sentence {
    display: block;
    text-wrap: balance;
  }
  .phrase {
    display: inline-block;
  }
  :lang(en) .phrase {
    display: inline;
  }

  /* ================= Below the opening scene: one night, one thread ================= */
  .night {
    /* One set of distances for the whole page. */
    --act: clamp(5.5rem, 3.25rem + 7vw, 10rem); /* between sections */
    --lead: clamp(2.25rem, 1.5rem + 2.5vw, 4rem); /* a heading to what follows it */
    --wide: 84rem; /* the widest a section's content runs */
    position: relative;
    isolation: isolate;
    overflow-x: clip; /* the full-bleed paintings and the motto's dark pool stop at the screen's edge */
    /* The opening scene ends on #070c20: start there and settle into the night ground. */
    background: linear-gradient(#070c20, var(--ground) 40rem);
    color: var(--ink-soft);
    font-family: var(--sans-en);
    /* Body text in Hanken Grotesk: 18px on phones, 18.75px wide (its x-height is 0.49 em, so this
       reads as large as the 19–20px of the low-set face it replaced). Chinese 17px → 18px. */
    font-size: clamp(1.125rem, 1.07rem + 0.15vw, 1.171875rem);
    line-height: 1.68;
  }
  .night:lang(zh-Hans) {
    font-family: var(--sans-zh);
    font-size: clamp(1.0625rem, 1rem + 0.15vw, 1.125rem);
    line-height: 1.9;
  }

  /* ---------- The thread ---------- */
  .silk {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    /* It comes out of the opening scene: faded in over its first 130px. */
    -webkit-mask-image: linear-gradient(transparent, #000 130px);
    mask-image: linear-gradient(transparent, #000 130px);
  }
  .silk path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    visibility: hidden; /* until the script has placed and measured it */
  }
  .silk .core {
    stroke-width: 1.6px;
  }
  /* The soft light around it: a wide, faint stroke (no blur filter, so scrolling stays cheap). */
  .silk .glow {
    stroke-width: 7px;
    opacity: 0.16;
  }

  main {
    padding-inline: var(--gutter);
  }
  /* Every section sits on the page's centre line, like the motto. */
  .act {
    max-width: var(--wide);
    margin-inline: auto;
    padding-top: var(--act);
  }
  .w {
    display: inline-block;
  }
  .w:lang(en) {
    display: inline;
  }
  /* No paragraph ends on a single word or character. */
  .night p {
    text-wrap: pretty;
  }
  /* One measure for body text: about 60–75 characters a line in English, 30–38 in Chinese. */
  .signs-list p,
  .steps p,
  .notes p,
  .limits-list p,
  .prose p {
    max-width: 33em;
  }
  .night:lang(zh-Hans) :is(.signs-list, .notes, .limits-list, .prose) p {
    max-width: 36em;
  }
  /* The situations and the steps: two-line texts, held to 30 characters a line so the second line
     is not a short stub. */
  .night:lang(zh-Hans) .signs-list p {
    max-width: 30em;
  }
  /* The last few words of a paragraph, held together (`para` in the frontmatter). */
  .glue {
    white-space: nowrap;
  }
  /* Below 1024 wide, held as one box instead: it still moves to the next line whole, but if it is
     wider than the column (very large text on a narrow phone) it wraps inside rather than running
     past the screen's edge. */
  @media (max-width: 63.99rem) {
    .glue {
      display: inline-block;
      max-width: 100%;
      white-space: normal;
    }
  }
  /* Short texts of two to four lines: evened out. (Not the steps' descriptions: evened out, each
     would take its own width and the column would look ragged.) */
  .means,
  .night h3 {
    text-wrap: balance;
  }

  /* One large line opens every section. */
  .display {
    margin: 0;
    max-width: 17em;
    color: var(--ink);
    font-family: var(--font-en);
    font-size: clamp(1.95rem, 1.15rem + 2.6vw, 3.4rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  /* Reached from the three numbers at the top: land with room above the heading. */
  .display[id] {
    scroll-margin-top: clamp(2.5rem, 10vh, 6rem);
  }
  /* The demo: land close under its heading, so the video comes into view with it. */
  .display#demo {
    scroll-margin-top: 1.25rem;
  }
  .display:lang(zh-Hans) {
    max-width: 16em;
    font-family: var(--font-zh);
    /* Song Bold beside the dark Latin face (see .headline:lang(zh-Hans)). */
    font-weight: 700;
    font-synthesis-weight: none;
    font-size: clamp(1.5rem, 1rem + 2.4vw, 3rem);
    line-height: 1.42;
    letter-spacing: 0.02em;
  }

  /* ---------- Situations: the line on the left, three plain entries on the right ---------- */
  /* The lightest scene: no numbers, only hairlines between the entries. */
  .signs {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    column-gap: clamp(2rem, 6vw, 6.5rem);
    align-items: start;
  }
  .signs .display {
    max-width: 10em;
  }
  .signs .display:lang(zh-Hans) {
    max-width: none; /* the column sets the measure; it breaks at its comma */
  }
  .signs-list {
    margin: 0;
    padding: 0.4rem 0 0;
    list-style: none;
  }
  .signs-list li + li {
    margin-top: clamp(1.6rem, 1rem + 1.5vw, 2.25rem);
    padding-top: clamp(1.6rem, 1rem + 1.5vw, 2.25rem);
    border-top: 1px solid var(--hairline);
  }
  .signs-list h3,
  .limits-list h3 {
    margin: 0;
    color: var(--ink);
    /* The middle rank: Hanken Grotesk 600, 18–21px, between the display headings and the body. */
    font-family: var(--sans-en);
    font-size: clamp(1.15rem, 1.05rem + 0.3vw, 1.3125rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.005em;
  }
  .signs-list h3:lang(zh-Hans),
  .limits-list h3:lang(zh-Hans) {
    font-family: var(--head-zh);
    font-weight: 400;
    font-size: clamp(1.3rem, 1.1rem + 0.5vw, 1.55rem);
    line-height: 1.5;
    letter-spacing: 0.03em;
  }
  .signs-list p,
  .limits-list p {
    margin: 0.7rem 0 0;
  }

  /* ---------- The approach: four steps in a row each ---------- */
  .steps {
    margin: var(--lead) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }
  .steps li {
    display: grid;
    grid-template-columns: clamp(4.5rem, 3rem + 4vw, 7.5rem) minmax(0, 1fr) minmax(0, 1.5fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    align-items: baseline;
    padding-block: clamp(1.75rem, 1rem + 2vw, 2.75rem);
    border-bottom: 1px solid var(--hairline);
  }
  .step-num {
    color: var(--ink-faint);
    font-family: var(--font-en);
    font-size: clamp(1.75rem, 1.3rem + 1.2vw, 2.5rem);
    font-style: italic;
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
  /* The one place the dyes show up in the steps: the number of the row under the pointer. */
  .steps li:hover .step-num {
    background: linear-gradient(100deg, var(--silk-rose), var(--silk-gold) 55%, var(--silk-teal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .steps h3 {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-en);
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.625rem);
    font-weight: 400;
    line-height: 1.2;
  }
  .steps h3:lang(zh-Hans) {
    font-family: var(--font-zh);
    font-size: clamp(1.35rem, 1.05rem + 0.9vw, 1.8rem);
    letter-spacing: 0.04em;
  }
  .steps p {
    margin: 0;
  }
  /* Chinese step names are short: their column narrows and the description gets the room. */
  @media (min-width: 52rem) {
    .steps:lang(zh-Hans) li {
      grid-template-columns: clamp(4.5rem, 3rem + 4vw, 7.5rem) minmax(0, 0.8fr) minmax(0, 1.6fr);
    }
  }
  .steps p:lang(zh-Hans) {
    max-width: 30em;
    line-height: 1.85;
  }

  /* ---------- The demo video, and the table of what each stage hands over ---------- */
  /* The lead on the left and the video's pause button on its right, on the lead's last line,
     just above the video; then the video, the table and the notes across the whole width. */
  .demo-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 2rem;
    margin-top: calc(var(--lead) * 0.6);
  }
  .demo-body > :not(.demo-lead, .motion-toggle) {
    grid-column: 1 / -1;
  }
  .demo-lead {
    max-width: 32em;
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.65;
  }
  .demo-lead:lang(zh-Hans) {
    max-width: 38em;
    font-size: 1.1875rem;
    line-height: 1.85;
  }
  .demo-body > .motion-toggle {
    align-self: last baseline;
  }
  .demo-body > .frame {
    margin-top: calc(var(--lead) * 0.6);
  }
  .frame {
    position: relative;
    overflow: hidden;
    background: #060a16;
    border-radius: 14px;
    box-shadow: 0 40px 90px -44px rgb(0 0 0 / 0.85);
  }
  /* The hairline round the video, drawn over it. */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--hairline);
    border-radius: inherit;
    pointer-events: none;
  }
  .frame video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  /* The table: a header row, then one row per stage, hairlines between. Each row is a grid
     of the stage's name and its three cells; the header row uses the same grid. */
  .roles-head,
  .roles li {
    --name: clamp(9rem, 5rem + 6vw, 13rem);
    display: grid;
    grid-template-columns: var(--name) minmax(0, 1fr);
    column-gap: clamp(1.25rem, 3vw, 3rem);
  }
  .roles-head .cells,
  .roles dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.25rem, 3vw, 3rem);
  }
  .roles-head {
    margin-top: clamp(2.5rem, 1.5rem + 2vw, 3.5rem);
    padding-bottom: 0.9rem;
    color: var(--ink-faint);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .roles-head:lang(zh-Hans) {
    font-size: 0.9375rem;
  }
  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--hairline);
  }
  .roles li {
    --pad: clamp(1.2rem, 0.9rem + 0.8vw, 1.6rem);
    position: relative;
    align-items: baseline;
    padding-block: var(--pad);
  }
  /* A hairline above each row. */
  .roles li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--hairline);
  }
  /* The row the video is on: a short upright line in the silk's dyes, just outside the left edge
     of the text, beside the stage's name (so it cannot be read as the line under the row above). */
  .roles li::after {
    content: '';
    position: absolute;
    top: calc(var(--pad) + 0.15rem);
    left: calc(-1 * clamp(0.75rem, 1.7vw, 1.5rem));
    width: 2px;
    height: 1.9rem;
    border-radius: 1px;
    background: linear-gradient(var(--silk-rose), var(--silk-gold) 50%, var(--silk-teal));
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .linked li.on::after {
    opacity: 1;
  }
  /* The number in DM Serif Display italic; the name in the middle rank, Hanken Grotesk 600. */
  .stage {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-en);
    font-size: clamp(1.3rem, 1.12rem + 0.45vw, 1.55rem);
    font-weight: 400;
    line-height: 1.22;
  }
  .stage-name {
    font-family: var(--sans-en);
    font-size: clamp(1.15rem, 1.05rem + 0.3vw, 1.3125rem);
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .stage:lang(zh-Hans) {
    font-family: var(--font-zh);
    font-size: clamp(1.3rem, 1.1rem + 0.45vw, 1.5rem);
    letter-spacing: 0.04em;
  }
  .stage-name:lang(zh-Hans) {
    font-family: var(--head-zh);
    font-size: inherit;
    font-weight: 400;
  }
  /* The number carries the silk's dyes under its colour: they show once the colour goes
     transparent (the current row, or the row under the pointer), so the change can fade. */
  .stage-num {
    margin-right: 0.7rem;
    color: var(--ink-faint);
    background: linear-gradient(100deg, var(--silk-rose), var(--silk-gold) 55%, var(--silk-teal));
    -webkit-background-clip: text;
    background-clip: text;
    font-family: var(--font-en);
    font-style: italic;
    font-variant-numeric: lining-nums;
    letter-spacing: 0;
  }
  .roles dl {
    margin: 0;
  }
  /* The cells: a step under the body text (17px, Chinese 17px), never under 16px. */
  .roles dd {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .roles dd:lang(zh-Hans) {
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .roles dt {
    color: var(--ink-faint);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .roles dt:lang(zh-Hans) {
    font-size: 0.9375rem;
  }
  .roles .dt-short {
    display: none;
  }
  /* Side by side, the header row names the columns, so each cell's own label is for screen readers. */
  @media (min-width: 52rem) {
    .roles dt {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  /* Following the video: the other four rows step back one shade (still well above 4.5:1); the
     current one comes up to the brightest ink, its number in the dyes, the short line beside it.
     The row under the pointer brightens the same way, so it reads as something to click. */
  .roles li,
  .stage,
  .stage-num {
    transition: color 0.2s ease;
  }
  .linked li {
    cursor: pointer;
    color: #a3a8c0;
  }
  .linked .stage {
    color: #bfc3d6;
  }
  .linked li.on,
  .linked li.on .stage,
  .linked li:hover,
  .linked li:hover .stage {
    color: var(--ink);
  }
  .linked li.on .stage-num,
  .linked li:hover .stage-num {
    color: transparent;
  }
  /* The buttons are made by the script, so they carry no scoped-style attribute: :global. */
  .roles :global(.stage-go) {
    display: inline;
    margin: 0;
    padding: 0.15rem 0;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-align: start;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .roles :global(.stage-go:hover) {
    color: var(--ink);
  }
  .roles :global(.stage-go:focus-visible) {
    outline: 2px solid var(--rouge);
    outline-offset: 6px;
  }
  @media (prefers-reduced-motion: reduce) {
    .roles li,
    .roles li::after,
    .stage,
    .stage-num {
      transition: none;
    }
  }

  /* Under the table: the note on export work in body text, the disclaimer a step smaller. */
  .notes {
    margin-top: 2rem;
  }
  .notes p {
    margin: 0;
  }
  .notes .aside {
    margin-top: 0.6rem;
    color: var(--ink-faint);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .notes .aside:lang(zh-Hans) {
    font-size: 0.9375rem;
  }
  .demo .motion-toggle {
    min-height: 2.5rem;
    padding: 0.4rem 1.1rem;
    color: var(--ink-soft);
    background: transparent;
    border-color: rgb(243 240 234 / 0.28);
    font-size: 0.875rem;
  }
  .demo .motion-toggle:lang(zh-Hans) {
    font-size: 0.9rem;
  }

  /* ---------- Three things not handed to AI: open columns, no order ---------- */
  /* After the fullest scene, room to breathe: a wide gap before it, three short texts. */
  .limits-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5.5rem);
    row-gap: 2.75rem;
    margin: calc(var(--lead) * 1.2) 0 0;
    padding: 0;
    list-style: none;
  }
  .limits-list li {
    padding-top: 1.6rem;
    background: linear-gradient(rgb(243 240 234 / 0.38), rgb(243 240 234 / 0.38)) 0 0 / 2.75rem 1px no-repeat;
  }
  .limits-list p {
    margin-top: 0.85rem;
  }

  /* ---------- Now: the line on the left, two paragraphs on the right ---------- */
  /* Before the three limits and before the name, more room: the thread swings across the page there. */
  .limits,
  .name {
    --before: min(15rem, max(var(--act) * 1.5, 13rem));
    padding-top: var(--before);
  }
  .now {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    column-gap: clamp(2rem, 6vw, 6.5rem);
    align-items: start;
  }
  .now .display {
    max-width: 11em;
  }
  .now .display:lang(zh-Hans) {
    max-width: none;
  }
  .prose {
    padding-top: 0.5rem;
  }
  .prose p {
    margin: 0;
  }
  .prose p + p {
    margin-top: 1.1em;
  }

  /* ---------- Latest: a plain list, shown once there is something in it ---------- */
  .posts {
    max-width: 56rem;
    margin: var(--lead) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }
  .posts a {
    display: block;
    padding-block: 1.25rem;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
  }
  .post-title {
    display: block;
    color: var(--ink);
    font-family: var(--font-en);
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    line-height: 1.3;
  }
  .post-title:lang(zh-Hans) {
    font-family: var(--font-zh);
  }
  .post-meta {
    display: block;
    margin-top: 0.35rem;
    color: var(--ink-faint);
    font-size: 0.875rem;
  }
  .post-meta:lang(zh-Hans) {
    font-size: 0.9rem;
  }
  .posts a:hover .post-title {
    color: var(--rouge);
  }

  /* ---------- The name: the page's last and largest scene ---------- */
  .name {
    max-width: none;
  }
  .name-head {
    position: relative;
    padding-top: clamp(1rem, 3vw, 3rem);
  }
  /* The silk-ribbon painting, full bleed behind the motto, fading into the night above and below. */
  .art {
    position: absolute;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .band {
    top: calc(-1 * var(--before));
    bottom: -4rem;
    left: calc(-1 * var(--gutter));
    right: calc(-1 * var(--gutter));
    -webkit-mask-image: linear-gradient(transparent, #000 30%, #000 62%, transparent);
    mask-image: linear-gradient(transparent, #000 30%, #000 62%, transparent);
  }
  .band img {
    opacity: 0.5;
    object-position: 50% 40%;
  }
  .motto {
    /* Never edge to edge: the thread passes beside it. */
    max-width: min(22em, 100% - 2 * clamp(1.5rem, 8vw, 6rem));
    margin: 0 auto;
    color: var(--ink);
    font-family: var(--font-en);
    font-size: clamp(1.5rem, 0.92rem + 2.1vw, 2.65rem);
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-align: center;
    text-shadow:
      0 0 18px rgb(7 11 26 / 0.9),
      0 2px 40px rgb(7 11 26 / 0.8);
  }
  /* English: the motto in DM Serif Display italic, a size under the four words below, softer
     ink, open leading, so Seres / sericus / serico stay the heaviest thing in this scene. */
  .motto:lang(en) {
    max-width: min(24em, 100% - 2 * clamp(1.5rem, 8vw, 6rem));
    color: rgb(243 240 234 / 0.88);
    font-size: clamp(1.375rem, 0.95rem + 1.5vw, 2.25rem);
    font-style: italic;
    line-height: 1.45;
    letter-spacing: 0;
  }
  .motto:lang(zh-Hans) {
    max-width: min(21em, 100% - 2 * clamp(1.5rem, 8vw, 6rem));
    font-family: var(--font-zh);
    font-size: clamp(1.35rem, 0.95rem + 1.7vw, 2.4rem);
    line-height: 1.65;
    letter-spacing: 0.03em;
  }
  .motto .sentence + .sentence {
    margin-top: 0.3em;
  }
  /* A soft dark pool right behind the words, so the brightest ribbons never run through the
     letters; the ribbons either side keep their full light. */
  .motto {
    position: relative;
  }
  .motto::before {
    content: '';
    position: absolute;
    inset: -1.5em -2.5em;
    z-index: -1;
