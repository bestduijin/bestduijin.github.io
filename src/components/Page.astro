---
// The whole page, in one language. Wording comes from src/copy.ts.
import Base from '../layouts/Base.astro';
import { copy, site, type Lang } from '../copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];

// The demo loop under "What I do": a 15-second automation dashboard, rendered from
// B003/讲解视频/主页封面_自动化大屏.
const demo = (ext: 'mp4' | 'jpg') => `/cover/cover_${lang}_h.${ext}`;
// The opening scene: a painted illustration (B003/个人主页_插画), with light that moves over it (src/scripts/sky.ts).
const toggle = (labels: [string, string]) => ({
  'aria-label': labels[0],
  'data-pause': c.motion.pause,
  'data-play': c.motion.play,
  'data-pause-label': labels[0],
  'data-play-label': labels[1],
});

// Line icons for the three cards in "What I do", stroked with the silk gradient.
const ICONS = [
  // read the process: a lens over a flow of steps
  '<circle cx="14" cy="14" r="8"/><path d="M20 20l7 7"/><path d="M3 30h6M13 30h6M23 30h6" opacity=".55"/><circle cx="14" cy="14" r="2.5"/>',
  // build the fix: blocks stacking up
  '<rect x="4" y="18" width="11" height="11" rx="2"/><rect x="17" y="18" width="11" height="11" rx="2"/><rect x="10.5" y="5" width="11" height="11" rx="2"/>',
  // let it run: a loop that keeps going
  '<path d="M27 12a11 11 0 1 0 1.5 7"/><path d="M27 4v8h-8"/><path d="M13.5 12.5v7l6-3.5z"/>',
];

// Chinese has no spaces, so a browser may break a line in the middle of a word.
// In the introduction, lines may only break after punctuation.
const phrases = (s: string) => (lang === 'zh' ? (s.match(/[^，、；。]+[，、；。]?/g) ?? [s]) : [s]);
---

<Base lang={lang}>
  <header class="hero" data-motion="sky">
    <div class="scene" aria-hidden="true">
      <div class="drift">
        <picture>
          <source media="(max-aspect-ratio: 3/4)" srcset="/hero/hero_tall.webp" />
          <img class="art" src="/hero/hero_wide.webp" alt="" fetchpriority="high" />
        </picture>
        <canvas class="sky"></canvas>
      </div>
    </div>
    <div class="bar-top">
      <button class="motion-toggle" type="button" hidden {...toggle(c.motion.hero)}>{c.motion.pause}</button>
      <a class="switch" href={c.other.href} hreflang={c.other.hreflang} lang={c.other.hreflang}>{c.other.label}</a>
    </div>
    <div class="intro">
      <div class="mark">
        <h1 class="wordmark" lang="it">Serico</h1>
      </div>
      <p class="say">{c.say}</p>
      <p class="headline">
        <span class="sentence">{phrases(c.headline).map((phrase) => <span class="phrase">{phrase}</span>)}</span>
      </p>
      <p class="lead">
        {c.intro.map((sentence) => <span class="sentence">{phrases(sentence).map((phrase) => <span class="phrase">{phrase}</span>)}</span>)}
      </p>
      <dl class="figures">
        {
          c.figures.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  <main>
    <section class="row wide" aria-labelledby="skills">
      <h2 id="skills">{c.skills.heading}</h2>
      <div class="col">
        <ol class="skills">
          {
            c.skills.items.map((s, i) => (
              <li class="card">
                <span class="card-top" aria-hidden="true">
                  <svg class="icon" viewBox="0 0 32 32" set:html={`<defs><linearGradient id="silk${i}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--silk-rose)"/><stop offset=".5" stop-color="var(--silk-gold)"/><stop offset="1" stop-color="var(--silk-teal)"/></linearGradient></defs><g fill="none" stroke="url(#silk${i})" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ICONS[i]}</g>`} />
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                </span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ol>
        <figure class="demo" data-motion="video">
          <video class="demo-video" muted loop playsinline preload="none" poster={demo('jpg')} disablepictureinpicture aria-hidden="true">
            <source src={demo('mp4')} type="video/mp4" />
          </video>
          <figcaption>
            <span>{c.skills.demo}</span>
            <button class="motion-toggle" type="button" hidden {...toggle(c.motion.demo)}>{c.motion.pause}</button>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="row" aria-labelledby="now">
      <h2 id="now">{c.now.heading}</h2>
      <div class="col">
        {c.now.body.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="row" aria-labelledby="latest">
      <h2 id="latest">{c.latest.heading}</h2>
      <div class="col">
        {
          c.latest.items.length ? (
            <ul class="posts">
              {c.latest.items.map((p) => (
                <li>
                  <a href={p.href}>
                    <span class="post-meta">
                      {p.kind} · {p.where} · <time datetime={p.date}>{p.date}</time>
                    </span>
                    <span class="post-title">{p.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">{c.latest.empty}</p>
          )
        }
      </div>
    </section>

    <section class="row" aria-labelledby="find">
      <h2 id="find">{c.find.heading}</h2>
      <p class="col find">
        <span class="where">{c.find.github}</span>
        <a href={site.github.href} rel="me">{site.github.label}</a>
      </p>
    </section>

    <section class="row coda" aria-labelledby="name">
      <h2 id="name">{c.name.heading}</h2>
      <div class="col">
        <p class="motto">
          {c.name.motto.map((sentence) => <span class="sentence">{phrases(sentence).map((phrase) => <span class="phrase">{phrase}</span>)}</span>)}
        </p>
        <ol class="stops">
          {
            c.name.stops.map((s) => (
              <li>
                <span class="word" lang={s.lang}>{s.word}</span>
                <span class="from">{s.from}</span>
                <span class="means">{s.means}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </main>

  <footer class="foot">
    <p>© {site.year} Serico</p>
    <p>{c.colophon}</p>
  </footer>
</Base>

<script>
  import { startSky } from '../scripts/sky';

  // Every moving part can be paused (WCAG 2.2.2 Pause, Stop, Hide), and nothing moves
  // on its own when the visitor asks the system for reduced motion.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  for (const block of document.querySelectorAll<HTMLElement>('[data-motion]')) {
    const button = block.querySelector<HTMLButtonElement>('.motion-toggle');
    if (!button) continue;
    // Plays unless reduced motion is on; the button is the visitor's own choice and wins.
    let playing = !reduce.matches;
    let visible = true;

    let run: (on: boolean) => void;
    if (block.dataset.motion === 'video') {
      const video = block.querySelector('video')!;
      video.muted = true;
      run = (on) => {
        if (on) video.play().catch(() => {});
        else video.pause();
      };
    } else {
      const sky = startSky(block.querySelector('canvas')!, block.querySelector('img')!);
      run = (on) => sky.running(on);
    }

    const update = () => {
      button.textContent = playing ? button.dataset.pause! : button.dataset.play!;
      button.setAttribute('aria-label', playing ? button.dataset.pauseLabel! : button.dataset.playLabel!);
      block.classList.toggle('still', !playing);
      run(playing && visible); // only spend effort while on screen
    };

    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      update();
    }).observe(block);
    button.hidden = false;
    button.addEventListener('click', () => {
      playing = !playing;
      update();
    });
    reduce.addEventListener('change', () => {
      playing = !reduce.matches;
      update();
    });
    update();
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    /* One unit for the wordmark and its ribbon: a hundredth of the screen's
       width, held back on short screens so both still fit above the fold. */
    --u: min(1vw, 1.45svh);
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    grid-template-rows: auto 1fr;
    row-gap: 2rem;
    min-height: min(100svh, 62vw + 20rem);
    padding: 1.5rem var(--gutter) clamp(2.5rem, 7svh, 5rem);
    /* The hero always sits on the night-sky painting, in light and dark mode alike. */
    --ink: #f3f1f6;
    --ink-soft: #c9c6d8;
    --thread: #c9c6d8;
    --rouge: #ffa3b4;
    --ground: #0c1330;
    color: var(--ink);
    background: #0c1330;
  }

  /* ---------- The painted scene and the light moving over it ---------- */
  .scene {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  /* The picture drifts very slowly, like a camera breathing. */
  .drift {
    position: absolute;
    inset: 0;
    animation: drift 36s ease-in-out infinite alternate;
    transform-origin: 60% 30%;
  }
  .still .drift {
    animation-play-state: paused;
  }
  @keyframes drift {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.09) translate(-1.2%, 0.8%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .drift {
      animation: none;
    }
  }
  .drift img,
  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .drift img {
    object-fit: cover;
  }
  /* A night veil under the words: the sky stays bright, the dunes where the text sits go dark. */
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(8 12 32 / 0.92) 0%, rgb(8 12 32 / 0.7) 30%, rgb(8 12 32 / 0.15) 58%, rgb(8 12 32 / 0) 70%),
      linear-gradient(to right, rgb(8 12 32 / 0.55), rgb(8 12 32 / 0) 55%);
  }
  @media (max-width: 46rem) {
    .scene::after {
      background: linear-gradient(to top, rgb(8 12 32 / 0.95) 0%, rgb(8 12 32 / 0.8) 45%, rgb(8 12 32 / 0.35) 75%, rgb(8 12 32 / 0.2) 100%);
    }
  }
  .bar-top {
    justify-self: end;
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }
  .switch {
    font-size: 0.95rem;
  }
  /* Pause / play, for the scene and for the demo video. */
  .motion-toggle {
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink-soft);
    background: color-mix(in srgb, var(--ground) 60%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink-soft) 45%, transparent);
    border-radius: 999px;
    padding: 0.3rem 0.85rem;
    cursor: pointer;
    flex: none;
  }
  .motion-toggle:hover {
    color: var(--ink);
  }
  .motion-toggle:focus-visible {
    outline: 2px solid var(--rouge);
    outline-offset: 3px;
  }
  /* ---------- The demo video under "What I do" ---------- */
  .demo {
    margin: 2.75rem 0 0;
  }
  .demo video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    background: #070d16;
    box-shadow: 0 18px 50px -20px rgb(0 0 0 / 0.45);
  }
  .demo figcaption {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    margin-top: 0.85rem;
    color: var(--ink-soft);
    font-size: 0.85em;
    line-height: 1.6;
  }
  .intro {
    align-self: end;
  }
  .mark {
    position: relative;
  }
  .wordmark {
    text-shadow: 0 2px 30px rgb(8 12 32 / 0.5);
    margin: 0 0 0 -0.045em;
    font-size: calc(21 * var(--u));
    font-style: italic;
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  /* The ribbon's tail leaves the page just under the wordmark; the text starts below it. */
  .headline {
    margin: max(1.25rem, 4 * var(--u)) 0 0;
    font-size: clamp(1.35rem, 6.2vw, 2.6rem);
    line-height: 1.35;
    letter-spacing: 0.01em;
  }
  .lead {
    margin: 1.1rem 0 0;
    max-width: 36em;
    color: var(--ink-soft);
    font-size: clamp(1rem, 3.6vw, 1.2rem);
    line-height: 1.8;
  }

  /* Three numbers in a row, the figure large and its meaning under it. */
  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: 1.25rem clamp(2rem, 6vw, 5rem);
    margin: clamp(1.75rem, 4svh, 2.75rem) 0 0;
  }
  .figures div {
    display: flex;
    flex-direction: column-reverse;
    border-top: 1px solid var(--rouge);
    padding-top: 0.8rem;
  }
  .figures dd {
    margin: 0;
    font-size: clamp(1.5rem, 4.2vw, 2.25rem);
    line-height: 1.2;
    white-space: nowrap;
    font-variant-numeric: lining-nums;
  }
  .figures dt {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  /* One sentence per line; a sentence too long for the screen splits evenly. */
  .sentence {
    display: block;
    text-wrap: balance;
  }
  .phrase {
    display: inline-block;
  }
  :lang(en) .phrase {
    display: inline;
  }
  :lang(en) .lead {
    max-width: 34em;
    line-height: 1.5;
  }
  .say {
    margin: 0.75rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  /* ---------- Sections: a name on the left, the text on the right ---------- */
  main {
    padding-inline: var(--gutter);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 31em);
    column-gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .row > h2 {
    margin: 0;
    color: var(--ink-soft);
    font-size: 1em;
    font-weight: 400;
    line-height: inherit;
  }
  .col > p {
    margin: 0;
  }
  .col > p + p {
    margin-top: 1.1em;
  }
  .wide {
    grid-template-columns: minmax(0, 13rem) minmax(0, 52rem);
  }

  /* ---------- What I do: three cards edged with the silk of the opening scene ---------- */
  .skills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.2vw, 1.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    padding: 1.4rem 1.4rem 1.6rem;
    border-radius: 18px;
    border: 1px solid transparent;
    /* a fill inside, the silk gradient showing through only on the border */
    background:
      linear-gradient(var(--card-fill), var(--card-fill)) padding-box,
      linear-gradient(135deg, var(--silk-rose), var(--silk-gold) 50%, var(--silk-teal)) border-box;
    box-shadow: 0 18px 40px -28px var(--card-glow);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 50px -24px var(--card-glow);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transition: none;
      transform: none;
    }
  }
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .icon {
    width: 2.4rem;
    height: 2.4rem;
  }
  .num {
    color: var(--rouge);
    font-family: var(--font-en);
    font-style: italic;
    font-size: 0.95rem;
  }
  .card h3 {
    margin: 1.1rem 0 0.5rem;
    font-size: 1.25em;
    font-weight: 400;
  }
  .card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.95em;
    line-height: 1.7;
  }

  /* ---------- Latest ---------- */
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .posts li + li {
    border-top: 1px solid color-mix(in srgb, var(--thread) 35%, transparent);
  }
  .posts a {
    display: block;
    padding: 0.9rem 0;
    text-decoration: none;
    color: inherit;
  }
  .post-meta {
    display: block;
    color: var(--ink-soft);
    font-size: 0.8em;
  }
  .post-title {
    display: block;
    margin-top: 0.2rem;
    font-size: 1.1em;
  }
  .posts a:hover .post-title {
    color: var(--rouge);
  }
  .empty {
    margin: 0;
    color: var(--ink-soft);
  }
  .empty::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.6em;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--silk-rose), var(--silk-gold));
    vertical-align: 0.1em;
  }

  /* ---------- The name, as the page's closing note ---------- */
  .coda {
    border-top: 1px solid color-mix(in srgb, var(--thread) 30%, transparent);
    margin-top: clamp(1.5rem, 4vw, 3rem);
  }
  /* The owner's own lines about the name, kept as they were written. */
  .motto {
    margin: 0;
    font-size: 1.15em;
    line-height: 1.8;
  }

  /* ---------- The name's journey: four stops on one rouge thread ---------- */
  .stops {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 1.25rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }
  .stops li {
    position: relative;
    padding-top: 1.5rem;
  }
  /* A knot at each stop, and the thread running on to the next one. */
  .stops li::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--rouge);
  }
  .stops li:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: calc(100% + 1.25rem);
    border-top: 1px solid var(--rouge);
  }
  .stops span {
    display: block;
  }
  .word {
    font-size: 1.7em;
    font-style: italic;
    line-height: 1.25;
  }
  .word:lang(zh-Hans) {
    font-style: normal;
  }
  .from {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.8em;
    line-height: 1.5;
  }
  .means {
    font-size: 0.8em;
    line-height: 1.6;
  }

  /* ---------- Where to find me ---------- */
  .find {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .where {
    color: var(--ink-soft);
  }

  .foot {
    padding: 2rem var(--gutter) 3rem;
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .foot p {
    margin: 0;
  }

  /* ---------- Narrower screens: the section name moves above its text ---------- */
  @media (max-width: 60rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1rem;
    }
    .col {
      max-width: 34em;
    }
  }
  /* ---------- Phones: the thread runs downward ---------- */
  @media (max-width: 46rem) {
    .figures,
    .skills {
      grid-template-columns: minmax(0, 1fr);
    }
    .stops {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
      margin-top: 2.25rem;
    }
    .stops li {
      padding: 0 0 0 1.75rem;
    }
    .stops li::before {
      top: 0.9rem;
    }
    .stops li:not(:last-child)::after {
      top: calc(0.9rem + 3px);
      width: 0;
      height: calc(100% + 1.5rem);
      border-top: 0;
      border-left: 1px solid var(--rouge);
    }
  }
</style>
